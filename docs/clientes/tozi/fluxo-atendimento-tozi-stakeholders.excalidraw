  {
   "type": "text",
   "id": "t_c3t",
   "x": 840,
   "y": 763,
   "width": 680,
   "height": 20,
   "text": "\"Quero anunciar meu imóvel pra alugar\"",
   "originalText": "\"Quero anunciar meu imóvel pra alugar\"",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#008c70",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
