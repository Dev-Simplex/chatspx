   "x": 1605,
   "y": 503,
   "width": 680,
   "height": 20,
   "text": "\"Meu chuveiro quebrou\" (inquilino)",
   "originalText": "\"Meu chuveiro quebrou\" (inquilino)",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
