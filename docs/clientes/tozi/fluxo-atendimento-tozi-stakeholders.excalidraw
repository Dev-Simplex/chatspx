  {
   "type": "text",
   "id": "t_c6t",
   "x": 1605,
   "y": 1023,
   "width": 680,
   "height": 20,
   "text": "Sábado, 23h — fora do horário comercial",
   "originalText": "Sábado, 23h — fora do horário comercial",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#008c70",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
