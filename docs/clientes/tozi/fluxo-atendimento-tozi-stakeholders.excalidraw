  {
   "type": "text",
   "id": "t_c1t",
   "x": 840,
   "y": 503,
   "width": 680,
   "height": 20,
   "text": "\"Quero alugar uma casa de 3 quartos perto da UNEMAT\"",
   "originalText": "\"Quero alugar uma casa de 3 quartos perto da UNEMAT\"",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#008c70",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
