   "x": 1605,
   "y": 763,
   "width": 680,
   "height": 20,
   "text": "O interessado some no meio da conversa",
   "originalText": "O interessado some no meio da conversa",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#008c70",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
