   "y": 1305,
   "width": 700,
   "height": 26,
   "text": "REGRAS DE OURO — o que a IA NUNCA faz",
   "originalText": "REGRAS DE OURO — o que a IA NUNCA faz",
   "fontSize": 20,
   "fontFamily": 2,
