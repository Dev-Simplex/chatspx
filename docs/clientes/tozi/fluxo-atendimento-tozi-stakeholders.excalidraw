  {
   "type": "text",
   "id": "t_c5t",
   "x": 840,
   "y": 1023,
   "width": 680,
   "height": 20,
   "text": "\"Prefiro falar com uma pessoa\"",
   "originalText": "\"Prefiro falar com uma pessoa\"",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#008c70",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
