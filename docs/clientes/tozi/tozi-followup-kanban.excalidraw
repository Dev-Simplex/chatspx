    {
      "type": "text", "id": "legend_title",
      "x": 80, "y": 560,
      "width": 600, "height": 30,
      "text": "Transições não-lineares (lead vai e volta):",
      "originalText": "Transições não-lineares (lead vai e volta):",
      "fontSize": 16, "fontFamily": 3,
      "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
