    { "id": "lbl_cobranca", "type": "text", "x": 2200, "y": 800, "width": 280, "height": 36, "angle": 0, "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 500029, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "cobrança quem responde\né o corretor ao assumir", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "cobrança quem responde\né o corretor ao assumir", "lineHeight": 1.25 },
    { "id": "lb_note", "type": "text", "x": 1460, "y": 1005, "width": 480, "height": 18, "angle": 0, "strokeColor": "#6d28d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 500030, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "dúvida nova durante a espera? a IA responde na hora", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "dúvida nova durante a espera? a IA responde na hora", "lineHeight": 1.25 },

