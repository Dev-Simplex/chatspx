    { "id": "lb3t", "type": "text", "x": 2055, "y": 930, "width": 245, "height": 36, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 500027, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Depois, silêncio inteligente\n(insistir só irrita)", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "containerId": "lb3", "originalText": "Depois, silêncio inteligente\n(insistir só irrita)", "lineHeight": 1.25 },
