    { "id": "lbl_parou", "type": "text", "x": 540, "y": 790, "width": 210, "height": 36, "angle": 0, "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 600002, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "cliente parou de\nresponder no meio", "fontSize": 13, "fontFamily": 3, "textAlign": "right", "verticalAlign": "top", "containerId": null, "originalText": "cliente parou de\nresponder no meio", "lineHeight": 1.25 },

    { "id": "div_bottom", "type": "line", "x": 80, "y": 1190, "width": 2240, "height": 0, "angle": 0, "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 600003, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "points": [[0, 0], [2240, 0]] },
    { "id": "h_princ", "type": "text", "x": 110, "y": 1225, "width": 330, "height": 24, "angle": 0, "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 600004, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "PRINCÍPIOS INEGOCIÁVEIS", "fontSize": 19, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "PRINCÍPIOS INEGOCIÁVEIS", "lineHeight": 1.25 },
    { "id": "b_princ", "type": "text", "x": 110, "y": 1265, "width": 640, "height": 130, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 600005, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Cliente nunca fica sem resposta — atendimento 24/7\n• Uma conversa só: transferências invisíveis entre IAs\n• Humano no comando: assumiu, a IA cala na hora\n• Corretor recebe interessado com dossiê, não fila de curiosos\n• Toda passagem de bastão fica registrada (auditável)", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Cliente nunca fica sem resposta — atendimento 24/7\n• Uma conversa só: transferências invisíveis entre IAs\n• Humano no comando: assumiu, a IA cala na hora\n• Corretor recebe interessado com dossiê, não fila de curiosos\n• Toda passagem de bastão fica registrada (auditável)", "lineHeight": 1.25 },
    { "id": "h_hip", "type": "text", "x": 880, "y": 1225, "width": 460, "height": 24, "angle": 0, "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 600006, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "HIPÓTESES QUE O PILOTO VAI PROVAR", "fontSize": 19, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "HIPÓTESES QUE O PILOTO VAI PROVAR", "lineHeight": 1.25 },
    { "id": "b_hip", "type": "text", "x": 880, "y": 1265, "width": 700, "height": 130, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 600007, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "H1 — Disparo curto + IA explicadora = o volume do template curto\n     com a qualidade do template longo\nH2 — Corretor gasta o tempo fechando, não triando curiosos\nH3 — Resposta imediata a qualquer hora = menos lead perdido\n     pro concorrente", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "H1 — Disparo curto + IA explicadora = o volume do template curto\n     com a qualidade do template longo\nH2 — Corretor gasta o tempo fechando, não triando curiosos\nH3 — Resposta imediata a qualquer hora = menos lead perdido\n     pro concorrente", "lineHeight": 1.25 },
    { "id": "h_kpi", "type": "text", "x": 1720, "y": 1225, "width": 340, "height": 24, "angle": 0, "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 600008, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "O QUE MEDIMOS NO PAINEL", "fontSize": 19, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "O QUE MEDIMOS NO PAINEL", "lineHeight": 1.25 },
    { "id": "b_kpi", "type": "text", "x": 1720, "y": 1265, "width": 560, "height": 130, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 600009, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "• Taxa de resposta por campanha e template\n• % de leads qualificados entregues ao corretor\n• Tempo de espera até o corretor assumir\n• Saúde do número na Meta\n• Visitas e contratos gerados por campanha", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Taxa de resposta por campanha e template\n• % de leads qualificados entregues ao corretor\n• Tempo de espera até o corretor assumir\n• Saúde do número na Meta\n• Visitas e contratos gerados por campanha", "lineHeight": 1.25 }
  ]
