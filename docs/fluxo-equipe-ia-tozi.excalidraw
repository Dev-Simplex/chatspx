    { "id": "capabilities", "type": "text", "x": 680, "y": 605, "width": 890, "height": 72, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 300025, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Sozinhas, as especialistas: buscam imóveis por distância real (\"a 0,8 km do seu trabalho\"),\nenviam fotos, entendem áudio e localização compartilhada, respondem dúvidas com a base\nde conhecimento da Tozi e registram tudo o que o lead contou.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Sozinhas, as especialistas: buscam imóveis por distância real (\"a 0,8 km do seu trabalho\"),\nenviam fotos, entendem áudio e localização compartilhada, respondem dúvidas com a base\nde conhecimento da Tozi e registram tudo o que o lead contou.", "lineHeight": 1.25 },

