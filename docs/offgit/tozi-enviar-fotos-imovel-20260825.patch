@@ -95,6 +99,20 @@ class Captain::Tools::EnviarFotosImovelTool < Captain::Tools::BasePublicTool
     Array(attrs['codigos_buscados']).map(&:to_s) + (mapa.is_a?(Hash) ? mapa.keys.map(&:to_s) : [])
