<%
  k = @data[:kpis]
  cards = k[:cards].to_i
  open_count = k[:open].to_i
  unassigned = k[:unassigned].to_i
  overdue = k[:overdue].to_i
  resolved_today = k[:resolved_today].to_i
  created_today = k[:created_today].to_i

  variant = overdue.positive? ? 'warning' : 'success'
  verdict =
    if overdue.positive?
      "#{number_with_delimiter(cards)} cards no funil, dos quais #{number_with_delimiter(overdue)} estão atrasados (passaram do SLA da coluna). Priorize esses cards para conter o tempo de espera."
    else
      "#{number_with_delimiter(cards)} cards no funil e nenhum card atrasado. O funil está em dia com os SLAs configurados nas colunas."
    end
%>

<%# ---------- Veredito (data-driven) ---------- %>
<div class="section">
  <%= render 'reports/pdf/callout', variant: variant,
        title: "#{number_with_delimiter(cards)} cards · #{number_with_delimiter(overdue)} atrasados",
        body: verdict %>
</div>

<%# ---------- KPIs do snapshot (espelha o Painel do funil) ---------- %>
<div class="section">
  <%= render 'reports/pdf/kpi_band', cards: [
    { label: 'Cards', value: number_with_delimiter(cards), hero: true, hint: 'total no funil' },
    { label: 'Abertas', value: number_with_delimiter(open_count), hint: 'em andamento' },
    { label: 'Resolvidas hoje', value: number_with_delimiter(resolved_today), hint: 'encerradas hoje' },
    { label: 'Novas hoje', value: number_with_delimiter(created_today), hint: 'criadas hoje' },
    { label: 'Sem responsável', value: number_with_delimiter(unassigned), modifier: 'is-passive', hint: 'sem atribuição' },
    { label: 'Atrasadas', value: number_with_delimiter(overdue), modifier: 'is-detractor', hint: 'fora do SLA' },
  ] %>
</div>

<%# ---------- Cards por coluna ---------- %>
<% if @data[:stage_chart].present? %>
  <div class="section">
    <div class="section-title"><span class="dot">1</span> Cards por coluna</div>
    <div class="card">
      <%= pdf_bar_chart(@data[:stage_chart]) %>
      <%= render 'reports/pdf/chart_caption', emoji: '🟩',
            text: 'Quantidade de cards parados em cada coluna do funil neste momento.' %>
    </div>
  </div>

  <% if @data[:stages_table].present? && @data[:stages_table][:rows].present? %>
    <div class="section">
      <div class="card" style="padding:0;">
        <%= render 'reports/pdf/data_table', table: @data[:stages_table] %>
      </div>
    </div>
  <% end %>
<% end %>

<%# ---------- Carga por agente ---------- %>
<% if @data[:workload_chart].present? %>
  <div class="section">
    <div class="section-title"><span class="dot">2</span> Carga por agente</div>
    <div class="card">
      <%= pdf_bar_chart(@data[:workload_chart], color: '#1f93ff') %>
      <%= render 'reports/pdf/chart_caption', emoji: '🔵',
            text: 'Quantidade de cards atribuídos a cada atendente (top 10).' %>
    </div>
  </div>

  <% if @data[:workload_table].present? && @data[:workload_table][:rows].present? %>
    <div class="section">
      <div class="card" style="padding:0;">
        <%= render 'reports/pdf/data_table', table: @data[:workload_table] %>
      </div>
    </div>
  <% end %>
<% end %>

<%# ---------- Conclusao ---------- %>
<div class="section">
  <%= render 'reports/pdf/conclusion',
        title: 'Resumo executivo',
        body: "O funil <span class=\"hl\">#{@data[:funnel_name]}</span> do Kanban tem <span class=\"hl\">#{number_with_delimiter(cards)} cards</span>, com <span class=\"hl\">#{number_with_delimiter(open_count)}</span> em aberto e <span class=\"hl\">#{number_with_delimiter(overdue)}</span> atrasados. #{unassigned.positive? ? "Há #{number_with_delimiter(unassigned)} cards sem responsável aguardando atribuição." : 'Todos os cards têm responsável.'}".html_safe %>
</div>
