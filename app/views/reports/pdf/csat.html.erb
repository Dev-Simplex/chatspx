<%
  k = @data[:kpis]
  satisfaction = k[:satisfaction].to_f

  zone, zone_class, pill_class =
    if satisfaction >= 80
      ['Excelência', 'is-promoter', '']
    elsif satisfaction >= 60
      ['Atenção', 'is-passive', 'is-passive']
    else
      ['Zona Crítica', 'is-detractor', 'is-detractor']
    end

  composition = [
    { label: 'Satisfeitos', value: k[:satisfied], color: '#2dc46f' },
    { label: 'Neutros', value: k[:neutral], color: '#ffc53d' },
    { label: 'Insatisfeitos', value: k[:unsatisfied], color: '#e54666' }
  ]
%>

<%# ---------- Veredito (card com hierarquia: métrica · valor · meta · status) ---------- %>
<div class="section">
  <div class="verdict-grid">
    <%= render 'reports/pdf/verdict', v: @data[:verdict] %>
  </div>
</div>

<%# ---------- Hero stat + composicao ---------- %>
<div class="section">
  <div class="hero-row">
    <%= render 'reports/pdf/hero_stat',
          value: "#{k[:satisfaction]}%", value_class: zone_class,
          label: 'Satisfação (CSAT)', pill: zone, pill_class: pill_class,
          caption: 'Notas 4 e 5 sobre o total de respostas' %>
    <%= render 'reports/pdf/composition_bar',
          title: 'Composição das respostas',
          segments: composition %>
  </div>
</div>

<%# ---------- KPIs de apoio ---------- %>
<div class="section">
  <%= render 'reports/pdf/kpi_band', cards: [
    { label: 'Respostas', value: number_with_delimiter(k[:total]) },
    { label: 'Nota média', value: k[:avg_rating], hint: 'escala de 1 a 5' },
    { label: 'Taxa de resposta', value: "#{k[:response_rate]}%", hint: 'respondidas / enviadas' },
  ] %>
</div>

<%# ---------- Distribuicao das notas 1-5 ---------- %>
<div class="section">
  <div class="section-title"><span class="dot">1</span> Distribuição das notas</div>
  <div class="card">
    <%= pdf_nps_distribution(@data[:distribution]) %>
    <%= render 'reports/pdf/chart_legend', items: [
      { color: '#2dc46f', label: '😀 Satisfeitos (notas 4-5)' },
      { color: '#ffc53d', label: '😐 Neutros (nota 3)' },
      { color: '#e54666', label: '😞 Insatisfeitos (notas 1-2)' },
    ] %>
  </div>
</div>

<%# ---------- CSAT por atendente ---------- %>
<% if @data[:agents].present? %>
  <div class="section">
    <div class="section-title"><span class="dot">2</span> Satisfação por atendente</div>
    <%= render 'reports/pdf/perf_table',
          columns: { entity: 'Atendente', count: 'Respostas', perf: 'Desempenho (% satisfação)', index: 'CSAT' },
          rows: @data[:agents].first(18).map { |agent|
            sat = agent[:satisfaction].to_f
            badge_class = sat >= 80 ? 'up' : (sat >= 60 ? 'mid' : 'down')
            bar_color = sat >= 80 ? '#2dc46f' : (sat >= 60 ? '#ffc53d' : '#e54666')
            { name: agent[:name], count: agent[:total], ratio: sat / 100,
              bar_color: bar_color, badge: "#{agent[:satisfaction]}%", badge_class: badge_class }
          } %>
  </div>
<% end %>

<%# ---------- Amostra de comentarios ---------- %>
<% if @data[:feedbacks].present? %>
  <div class="section">
    <div class="section-title"><span class="dot">3</span> Amostra de comentários</div>
    <div class="card" style="padding:0;">
      <%= render 'reports/pdf/data_table', table: {
        columns: [{ label: 'Nota', align: 'right' }, { label: 'Comentário' }, { label: 'Atendente' }, { label: 'Data' }],
        rows: @data[:feedbacks].first(12).map { |fb|
          [fb[:rating], fb[:feedback], fb[:agent], fb[:date]]
        }
      } %>
    </div>
  </div>
<% end %>

<%# ---------- Conclusao (data-driven) ---------- %>
<div class="section">
  <%= render 'reports/pdf/conclusion',
        title: 'Leitura executiva',
        body: raw("A satisfação de <span class=\"hl\">#{k[:satisfaction]}%</span> posiciona a operação em <span class=\"hl\">#{zone.downcase}</span>, com nota média de <span class=\"hl\">#{k[:avg_rating]}</span> sobre #{k[:total]} respostas válidas. #{k[:satisfied]} clientes avaliaram positivamente (notas 4-5) frente a #{k[:unsatisfied]} insatisfeitos, com taxa de resposta de #{k[:response_rate]}%.") %>
</div>
