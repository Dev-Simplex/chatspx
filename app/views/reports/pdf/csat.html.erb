<%# CSAT no estilo do PDF de Conversas: manchete, "Os clientes gostaram?", "Melhorou ou piorou?", como foram as notas,
    cada atendente, quem deu nota baixa (para agir) e o que os clientes escreveram. %>
<%
  k = @data[:kpis]
  cmp = @data[:comparison] || {}
  satisfaction = k[:satisfaction].to_f
  br = ->(value) { number_with_precision(value, precision: 1, separator: ',', delimiter: '.', strip_insignificant_zeros: true) }
  faces = { 1 => '😞', 2 => '😑', 3 => '😐', 4 => '😀', 5 => '😍' }
  low = @data[:low_ratings] || []

  zone, zone_class, pill_class =
    if satisfaction >= 80
      ['Excelente', 'is-promoter', '']
    elsif satisfaction >= 60
      ['Atenção', 'is-passive', 'is-passive']
    else
      ['Precisa melhorar', 'is-detractor', 'is-detractor']
    end

  composition = [
    { label: 'Satisfeitos (4 e 5)', value: k[:satisfied], color: '#2dc46f' },
    { label: 'Neutros (3)', value: k[:neutral], color: '#ffc53d' },
    { label: 'Insatisfeitos (1 e 2)', value: k[:unsatisfied], color: '#e54666' }
  ]
%>

<div class="clarity-legend">
  <span><span class="status-dot status-dot--good"></span> bom</span>
  <span><span class="status-dot status-dot--warn"></span> atenção</span>
  <span><span class="status-dot status-dot--bad"></span> precisa melhorar</span>
</div>

<%= render 'reports/pdf/headline', headline: @data[:headline] %>

<%# ============ 1. OS CLIENTES GOSTARAM? ============ %>
<div class="section">
  <div class="narrative-title"><span class="q">1.</span> Os clientes gostaram?</div>
  <div class="hero-row">
    <%= render 'reports/pdf/hero_stat',
          value: "#{br.call(k[:satisfaction])}%", value_class: zone_class,
          label: 'Ficaram satisfeitos', pill: zone, pill_class: pill_class,
          caption: 'deram nota 4 ou 5, numa escala de 1 a 5' %>
    <%= render 'reports/pdf/composition_bar', title: 'Como foram as notas', segments: composition %>
  </div>
</div>

<%# ============ 2. MELHOROU OU PIOROU? ============ %>
<div class="section">
  <div class="narrative-title"><span class="q">2.</span> Melhorou ou piorou?</div>
  <%= render 'reports/pdf/kpi_band', cards: [
    { label: 'Satisfeitos', value: "#{br.call(k[:satisfaction])}%", hero: true,
      meaning: 'de cada 100 notas, quantas foram 4 ou 5', delta: pdf_delta(cmp[:satisfaction]) },
    { label: 'Notas recebidas', value: number_with_delimiter(k[:total]),
      meaning: 'clientes que responderam a pesquisa', delta: pdf_delta(cmp[:total]) },
    { label: 'Nota média', value: br.call(k[:avg_rating]), meaning: 'de 1 (muito ruim) a 5 (excelente)', delta: pdf_delta(cmp[:avg]) },
    { label: 'Responderam', value: "#{br.call(k[:response_rate])}%", meaning: 'das pesquisas enviadas' },
  ] %>
</div>

<div class="section">
  <div class="verdict-grid">
    <%= render 'reports/pdf/verdict', v: @data[:verdict] %>
  </div>
</div>

<%# ============ 3. COMO FORAM AS NOTAS? ============ %>
<div class="section">
  <div class="narrative-title"><span class="q">3.</span> Quantos clientes deram cada nota?</div>
  <div class="card">
    <%= pdf_nps_distribution(@data[:distribution]) %>
    <%= render 'reports/pdf/chart_legend', items: [
      { color: '#2dc46f', label: '😀 Satisfeitos (notas 4 e 5)' },
      { color: '#ffc53d', label: '😐 Neutros (nota 3)' },
      { color: '#e54666', label: '😞 Insatisfeitos (notas 1 e 2)' },
    ] %>
  </div>
</div>

<%# ============ 4. CADA ATENDENTE ============ %>
<% if @data[:agents].present? %>
  <div class="section">
    <div class="narrative-title"><span class="q">4.</span> Como foi cada atendente?</div>
    <%= render 'reports/pdf/perf_table',
          columns: { entity: 'Atendente', count: 'Notas', perf: 'Satisfeitos (de cada 100)', index: 'Satisfação' },
          rows: @data[:agents].first(18).map { |agent|
            sat = agent[:satisfaction].to_f
            badge_class = sat >= 80 ? 'up' : (sat >= 60 ? 'mid' : 'down')
            bar_color = sat >= 80 ? '#2dc46f' : (sat >= 60 ? '#ffc53d' : '#e54666')
            { name: agent[:name], count: agent[:total], ratio: sat / 100,
              bar_color: bar_color, badge: "#{br.call(agent[:satisfaction])}%", badge_class: badge_class }
          } %>
  </div>
<% end %>

<%# ============ 5. QUEM DEU NOTA BAIXA? ============ %>
<div class="section">
  <div class="narrative-title"><span class="q">5.</span> Quem deu nota baixa (1 ou 2)?</div>
  <% if low.any? %>
    <div class="card" style="padding: 2mm 4mm;">
      <table class="cl-table">
        <colgroup>
          <col style="width: 9%;"><col style="width: 10%;"><col style="width: 18%;"><col style="width: 18%;">
          <col style="width: 33%;"><col style="width: 12%;">
        </colgroup>
        <thead><tr><th>Nota</th><th>Conversa</th><th>Cliente</th><th>Atendente</th><th>O que escreveu</th><th>Quando</th></tr></thead>
        <tbody>
          <% low.each do |row| %>
            <tr>
              <td><%= faces[row[:rating]] %> <%= row[:rating] %></td>
              <td><%= row[:id] %></td>
              <td class="cl-wrap"><%= row[:contact] %></td>
              <td class="cl-wrap"><%= row[:agent] %></td>
              <td class="cl-wrap <%= 'muted' unless row[:feedback] %>"><%= row[:feedback] || 'não escreveu nada' %></td>
              <td class="muted"><%= row[:date] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p style="margin: 2mm 0 0; font-size: 10px; color: #667781;">As <%= low.size %> mais recentes. A lista completa está no sistema e no CSV.</p>
  <% else %>
    <%= render 'reports/pdf/callout', variant: 'success', title: 'Nenhuma nota baixa no período', body: 'Nenhum cliente deu nota 1 ou 2. 👍' %>
  <% end %>
</div>

<%# ============ 6. O QUE OS CLIENTES ESCREVERAM ============ %>
<% if @data[:feedbacks].present? %>
  <%# Até 10 e 12 linhas: as seções 5 e 6 cabem inteiras numa página, e o título não fica sozinho no pé. %>
  <div class="section">
    <div class="narrative-title"><span class="q">6.</span> O que os clientes escreveram?</div>
    <div class="card" style="padding: 2mm 4mm;">
      <table class="cl-table">
        <colgroup><col style="width: 9%;"><col style="width: 55%;"><col style="width: 22%;"><col style="width: 14%;"></colgroup>
        <thead><tr><th>Nota</th><th>Comentário</th><th>Atendente</th><th>Quando</th></tr></thead>
        <tbody>
          <% @data[:feedbacks].first(12).each do |fb| %>
            <tr>
              <td><%= faces[fb[:rating]] %> <%= fb[:rating] %></td>
              <td class="cl-wrap"><%= fb[:feedback] %></td>
              <td class="cl-wrap"><%= fb[:agent] %></td>
              <td class="muted"><%= fb[:date] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
