<%# Numero gigante + label + pill de zona. locals: value, label, value_class, pill, pill_class, caption %>
<div class="hero-stat">
  <div class="hero-value <%= local_assigns[:value_class] %>"><%= value %></div>
  <div class="hero-meta">
    <div class="hero-label"><%= label %></div>
    <% if local_assigns[:pill].present? %>
      <span class="hero-pill <%= local_assigns[:pill_class] %>"><%= pill %></span>
    <% end %>
    <% if local_assigns[:caption].present? %><div class="hero-caption"><%= caption %></div><% end %>
  </div>
</div>
