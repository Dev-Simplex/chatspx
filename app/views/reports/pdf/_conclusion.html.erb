<%# Caixa escura de conclusao. locals: title, body (body pode conter <span class="hl">) %>
<div class="conclusion">
  <span class="conclusion-logo">
    <% if (logo_uri = pdf_public_image_data_uri('android-icon-72x72.png')) %>
      <img src="<%= logo_uri %>" alt="ChatSPX">
    <% end %>
  </span>
  <% if local_assigns[:title].present? %><div class="conclusion-title"><%= title %></div><% end %>
  <div class="conclusion-body"><%= body %></div>
</div>
