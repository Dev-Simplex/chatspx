<%# Visão geral (situação de agora) no estilo do PDF de Conversas: manchete, "Como está agora?", quem espera há mais
    tempo, quando as conversas chegam e são resolvidas, e cada atendente e cada time agora. %>
<%
  k = @data[:kpis]
  open_count = k[:open].to_i
  unattended = k[:unattended].to_i
  unassigned = k[:unassigned].to_i
  pending = k[:pending].to_i
  waiting = @data[:waiting] || []
  agents = @data[:agents] || []
  teams = @data[:teams] || []
  frt_goal_h = Reports::TimeFormatPresenter.new(Reports::PdfBenchmarks.goal(:first_response)).format
%>

<div class="clarity-legend">
  <span><span class="status-dot status-dot--good"></span> bom</span>
  <span><span class="status-dot status-dot--warn"></span> atenção</span>
  <span><span class="status-dot status-dot--bad"></span> precisa melhorar</span>
</div>

<%= render 'reports/pdf/plain_verdict', verdict: @data[:plain_verdict] if @data[:plain_verdict] %>
<%= render 'reports/pdf/headline', headline: @data[:headline] %>

<%# ============ 1. COMO ESTÁ AGORA? ============ %>
<div class="section">
  <div class="narrative-title"><span class="q">1.</span> Como está agora?</div>
  <div class="hero-row">
    <%= render 'reports/pdf/hero_stat',
          value: number_with_delimiter(open_count), value_class: 'is-neutral',
          label: 'Conversas abertas agora',
          caption: "#{number_with_delimiter(pending)} pendentes (esperando o cliente ou adiadas)" %>
    <% if open_count.positive? %>
      <%= render 'reports/pdf/composition_bar', title: 'Das conversas abertas', segments: [
        { label: 'Esperam resposta', value: unattended, color: '#e54666' },
        { label: 'Em andamento', value: open_count - unattended, color: '#2dc46f' },
      ] %>
    <% end %>
  </div>
  <div style="margin-top: 4mm;">
    <%= render 'reports/pdf/kpi_band', cards: [
      { label: 'Abertas', value: number_with_delimiter(open_count), hero: true, meaning: 'conversas em andamento' },
      { label: 'Esperam resposta', value: number_with_delimiter(unattended), modifier: 'is-detractor',
        meaning: 'ainda sem 1ª resposta ou esperando resposta' },
      { label: 'Sem atendente', value: number_with_delimiter(unassigned), modifier: 'is-passive', meaning: 'ninguém é responsável' },
      { label: 'Pendentes', value: number_with_delimiter(pending), meaning: 'esperando o cliente ou adiadas' },
    ] %>
  </div>
</div>

<%# ============ 2. QUEM ESPERA HÁ MAIS TEMPO? ============ %>
<%# Tabela com colunas nomeadas (antes eram barras todas iguais e uma linha cinza sem dizer o que era cada coisa).
    Sao no maximo 10 linhas: a secao inteira fica numa pagina so (se nao couber, comeca na pagina seguinte). %>
<div class="section" style="break-inside: avoid;">
  <div class="narrative-title" style="break-after: avoid;"><span class="q">2.</span> Quem está esperando resposta há mais tempo?</div>
  <% if waiting.any? %>
    <p class="section-lead" style="break-after: avoid;">
      São conversas abertas em que <strong>o cliente mandou mensagem e ainda ninguém respondeu</strong>.
      Quem espera há mais tempo está no topo. A meta é responder em até <strong><%= frt_goal_h %></strong>.
    </p>
    <div class="cl-legend" style="break-after: avoid;">
      <span><i class="cl-dot good"></i> dentro da meta</span>
      <span><i class="cl-dot warn"></i> passou um pouco da meta</span>
      <span><i class="cl-dot bad"></i> passou muito da meta</span>
    </div>
    <div class="card" style="padding: 2mm 4mm; break-inside: avoid;">
      <table class="cl-table">
        <colgroup>
          <col style="width: 9%;"><col style="width: 19%;"><col style="width: 17%;"><col style="width: 15%;">
          <col style="width: 12%;"><col style="width: 14%;"><col style="width: 14%;">
        </colgroup>
        <thead>
          <tr><th>Conversa</th><th>Cliente</th><th>Caixa de entrada</th><th>Atendente</th><th>Time</th><th>Esperando desde</th><th>Já esperou</th></tr>
        </thead>
        <tbody>
          <% waiting.each do |row| %>
            <tr>
              <td><%= row[:id] %></td>
              <td class="cl-wrap"><strong><%= row[:contact] %></strong></td>
              <td class="cl-wrap"><%= row[:inbox] %></td>
              <td class="cl-wrap <%= 'muted' if row[:agent] == 'ninguém' %>"><%= row[:agent] %></td>
              <td class="cl-wrap <%= 'muted' if row[:team] == '—' %>"><%= row[:team] %></td>
              <td class="muted"><%= row[:since] %></td>
              <td><i class="cl-dot <%= row[:level] %>"></i> <strong><%= row[:waiting] %></strong></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p style="margin: 2mm 0 0; font-size: 10px; color: #667781;">
      <% if unattended > waiting.size %>
        Mostrando as <%= waiting.size %> que esperam há mais tempo, de <%= unattended %> sem resposta.
      <% else %>
        Estas são todas as <%= waiting.size %> conversas sem resposta.
      <% end %>
      Para ver a lista completa no sistema: Relatórios → Visão geral → clique no número de “Não atendidas”.
    </p>
  <% else %>
    <%= render 'reports/pdf/callout', variant: 'success', title: 'Ninguém está esperando resposta agora',
          body: 'Todas as conversas abertas já foram respondidas. 👍' %>
  <% end %>
</div>

<%# ============ 3 e 4. QUANDO? ============ %>
<div class="section">
  <div class="narrative-title"><span class="q">3.</span> Quando as conversas chegam? <small style="font-size: 10px; color: #8696a0;">(últimos 30 dias)</small></div>
  <div class="card">
    <%= pdf_heatmap(@data[:traffic_heatmap], palette: :traffic) %>
    <%= render 'reports/pdf/chart_caption', emoji: '🔵',
          text: 'Cada quadradinho é 1 hora de um dia da semana. Quanto mais escuro, mais conversas chegaram naquela hora (escala à direita).' %>
  </div>
</div>

<div class="section">
  <div class="narrative-title"><span class="q">4.</span> Quando as conversas são resolvidas? <small style="font-size: 10px; color: #8696a0;">(últimos 30 dias)</small></div>
  <div class="card">
    <%= pdf_heatmap(@data[:resolutions_heatmap], palette: :resolutions) %>
    <%= render 'reports/pdf/chart_caption', emoji: '🟢',
          text: 'Cada quadradinho é 1 hora de um dia da semana. Quanto mais escuro, mais conversas foram resolvidas naquela hora (escala à direita).' %>
  </div>
</div>

<%# ============ 5 e 6. CADA ATENDENTE E CADA TIME AGORA ============ %>
<% [[5, 'Cada atendente agora', 'Atendente', agents, false], [6, 'Cada time agora', 'Time', teams, true]].each do |n, title, col, rows, with_unassigned| %>
  <% next if rows.empty? %>
  <div class="section" style="<%= 'break-inside: auto;' if rows.size > 15 %>">
    <div class="narrative-title"><span class="q"><%= n %>.</span> <%= title %></div>
    <div class="card" style="padding: 2mm 4mm;<%= ' break-inside: auto;' if rows.size > 15 %>">
      <table class="cl-table">
        <colgroup>
          <col style="width: 34%;"><col style="width: 38%;"><col style="width: 14%;">
          <% if with_unassigned %><col style="width: 14%;"><% end %>
        </colgroup>
        <thead>
          <tr><th><%= col %></th><th>Abertas</th><th>Esperam resposta</th><% if with_unassigned %><th>Sem atendente</th><% end %></tr>
        </thead>
        <tbody>
          <% rows.each do |row| %>
            <tr>
              <td class="cl-wrap"><strong><%= row[:name] %></strong></td>
              <td>
                <div class="cl-track">
                  <div class="cl-fill" style="width: <%= [row[:bar_pct], 3].max %>%;"></div>
                  <span class="cl-value"><%= number_with_delimiter(row[:open]) %></span>
                </div>
              </td>
              <td class="<%= 'muted' if row[:unattended].zero? %>"><%= number_with_delimiter(row[:unattended]) %></td>
              <% if with_unassigned %><td class="<%= 'muted' if row[:unassigned].zero? %>"><%= number_with_delimiter(row[:unassigned]) %></td><% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
