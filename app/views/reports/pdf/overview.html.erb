<%
  k = @data[:kpis]
  open_count = k[:open].to_i
  unattended = k[:unattended].to_i
  unassigned = k[:unassigned].to_i
  pending = k[:pending].to_i

  variant = unattended.positive? ? 'warning' : 'success'
  verdict =
    if unattended.positive?
      "#{number_with_delimiter(open_count)} conversas abertas neste instante, das quais #{number_with_delimiter(unattended)} ainda não foram atendidas. Há fila aguardando primeira resposta — priorize a triagem para conter o tempo de espera."
    else
      "#{number_with_delimiter(open_count)} conversas abertas neste instante e nenhuma aguardando primeiro atendimento. A operação está em dia com a fila de entrada."
    end
%>

<%# ---------- Veredito (data-driven) ---------- %>
<div class="section">
  <%= render 'reports/pdf/callout', variant: variant,
        title: "#{number_with_delimiter(open_count)} conversas abertas · #{number_with_delimiter(unattended)} não atendidas",
        body: verdict %>
</div>

<%# ---------- KPIs do snapshot ---------- %>
<div class="section">
  <%= render 'reports/pdf/kpi_band', cards: [
    { label: 'Abertas', value: number_with_delimiter(open_count), hero: true, hint: 'em andamento agora' },
    { label: 'Não atendidas', value: number_with_delimiter(unattended), modifier: 'is-detractor', hint: 'aguardando 1ª resposta' },
    { label: 'Não atribuídas', value: number_with_delimiter(unassigned), modifier: 'is-passive', hint: 'sem responsável' },
    { label: 'Pendentes', value: number_with_delimiter(pending), hint: 'em espera/snooze' },
  ] %>
</div>

<%# ---------- Heatmap de trafego ---------- %>
<div class="section">
  <div class="section-title"><span class="dot">1</span> Tráfego (últimos 30 dias)</div>
  <div class="card">
    <%= pdf_heatmap(@data[:traffic_heatmap], palette: :traffic) %>
    <%= render 'reports/pdf/chart_caption', emoji: '🔵',
          text: 'Cada quadradinho é 1 hora do dia. Quanto mais escuro, mais conversas chegaram naquele horário (escala à direita).' %>
  </div>
</div>

<%# ---------- Heatmap de resolucoes ---------- %>
<div class="section">
  <div class="section-title"><span class="dot">2</span> Resoluções (últimos 30 dias)</div>
  <div class="card">
    <%= pdf_heatmap(@data[:resolutions_heatmap], palette: :resolutions) %>
    <%= render 'reports/pdf/chart_caption', emoji: '🟢',
          text: 'Cada quadradinho é 1 hora do dia. Quanto mais escuro, mais conversas foram resolvidas naquele horário (escala à direita).' %>
  </div>
</div>

<%# ---------- Por atendente ---------- %>
<% if @data[:agents_table].present? && @data[:agents_table][:rows].present? %>
  <div class="section">
    <div class="section-title"><span class="dot">3</span> Por atendente</div>
    <div class="card" style="padding:0;">
      <%= render 'reports/pdf/data_table', table: {
            columns: @data[:agents_table][:columns],
            rows: @data[:agents_table][:rows].first(18)
          } %>
    </div>
  </div>
<% end %>

<%# ---------- Por time ---------- %>
<% if @data[:teams_table].present? && @data[:teams_table][:rows].present? %>
  <div class="section">
    <div class="section-title"><span class="dot">4</span> Por time</div>
    <div class="card" style="padding:0;">
      <%= render 'reports/pdf/data_table', table: {
            columns: @data[:teams_table][:columns],
            rows: @data[:teams_table][:rows].first(18)
          } %>
    </div>
  </div>
<% end %>
