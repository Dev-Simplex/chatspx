<% if @data[:unavailable].present? %>
  <div class="card"><p style="color:#667781;"><%= @data[:unavailable] %></p></div>
<% else %>
<%
  k = @data[:kpis]
  total = k[:total].to_i
  breaches = k[:breaches].to_i
  honored = total - breaches
  compliance = k[:compliance].to_f
  hit_rate = k[:hit_rate]

  zone, value_class =
    if compliance >= 90
      ['Conforme', '']
    elsif compliance >= 70
      ['Atenção', 'is-passive']
    else
      ['Crítico', 'is-detractor']
    end

  composition = [
    { label: 'Cumpridos', value: honored, color: '#2dc46f' },
    { label: 'Descumpridos', value: breaches, color: '#e54666' }
  ]

  worst = (@data[:by_policy] || []).select { |p| p[:total].to_i.positive? }.min_by { |p| p[:hit_rate].to_f }
%>

<%# ---------- Veredito (card com hierarquia) ---------- %>
<% if @data[:verdict] %>
  <div class="section">
    <div class="verdict-grid">
      <%= render 'reports/pdf/verdict', v: @data[:verdict] %>
    </div>
  </div>
<% end %>

<%# ---------- Hero hit rate + composicao ---------- %>
<div class="section">
  <div class="hero-row">
    <%= render 'reports/pdf/hero_stat',
          value: hit_rate, value_class: value_class,
          label: 'Hit Rate', pill: zone, pill_class: value_class,
          caption: "#{honored} de #{total} SLAs cumpridos" %>
    <%= render 'reports/pdf/composition_bar',
          title: 'Cumprimento dos acordos',
          segments: composition %>
  </div>
</div>

<%# ---------- KPIs de apoio ---------- %>
<div class="section">
  <%= render 'reports/pdf/kpi_band', cards: [
    { label: 'SLAs aplicados', value: number_with_delimiter(total) },
    { label: 'Descumprimentos', value: number_with_delimiter(breaches), modifier: 'is-detractor', hint: 'acordos não cumpridos' },
    { label: 'Compliance', value: "#{compliance}%", modifier: 'is-promoter', hint: 'cumpridos / aplicados' },
  ] %>
</div>

<%# ---------- Desempenho por politica ---------- %>
<% if @data[:by_policy].present? %>
  <div class="section">
    <div class="section-title"><span class="dot">1</span> Desempenho por política de SLA</div>
    <%= render 'reports/pdf/perf_table',
          columns: { entity: 'Política', count: 'SLAs', perf: 'Desempenho', index: 'Hit rate' },
          rows: @data[:by_policy].first(18).map { |row|
            hr = row[:hit_rate].to_f
            badge_class = hr >= 90 ? 'up' : (hr >= 70 ? 'mid' : 'down')
            bar_color = hr >= 90 ? '#2dc46f' : (hr >= 70 ? '#ffc53d' : '#e54666')
            { name: row[:name], count: row[:total], ratio: hr / 100,
              bar_color: bar_color, badge: "#{hr}%", badge_class: badge_class }
          } %>
  </div>
<% end %>

<%# ---------- Descumprimentos recentes ---------- %>
<% if @data[:breaches_table][:rows].present? %>
  <div class="section">
    <div class="section-title"><span class="dot">2</span> Descumprimentos recentes</div>
    <div class="card" style="padding:0;">
      <%= render 'reports/pdf/data_table',
            table: @data[:breaches_table].merge(rows: @data[:breaches_table][:rows].first(18)) %>
    </div>
  </div>
<% end %>

<%# ---------- Conclusao (data-driven) ---------- %>
<div class="section">
  <%= render 'reports/pdf/conclusion',
        title: 'Leitura executiva',
        body: raw(
          "O hit rate de <span class=\"hl\">#{hit_rate}</span> coloca o nível de serviço em <span class=\"hl\">#{zone.downcase}</span>, " \
          "com #{honored} de #{total} SLAs cumpridos e #{breaches} descumprimentos no período." +
          (worst ? " A política <span class=\"hl\">#{worst[:name]}</span> concentra o maior risco, com hit rate de #{worst[:hit_rate]}% — priorize-a na recuperação dos acordos." : "")
        ) %>
</div>
<% end %>
