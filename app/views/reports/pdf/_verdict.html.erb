<%# Card de veredito (Destaque / Ponto de atenção). local: v => hash do resolver
    (kind, emoji, title, level, word, metric_label, value_human, goal_human, body). %>
<% level = (v[:level] || :warn).to_s %>
<div class="verdict verdict--<%= level %>">
  <div class="verdict-head">
    <span class="verdict-eyebrow"><span class="v-emoji"><%= v[:emoji] %></span><%= v[:title] %></span>
    <% if v[:word].present? %><span class="verdict-pill verdict-pill--<%= level %>"><%= v[:word] %></span><% end %>
  </div>
  <% if v[:value_human].present? %>
    <div class="verdict-metric"><%= v[:metric_label] %></div>
    <div class="verdict-figures">
      <span class="verdict-value verdict-value--<%= level %>"><%= v[:value_human] %></span>
      <% if v[:goal_human].present? %><span class="verdict-goal">meta <%= v[:goal_human] %></span><% end %>
    </div>
  <% else %>
    <div class="verdict-body"><%= v[:body] %></div>
  <% end %>
</div>
