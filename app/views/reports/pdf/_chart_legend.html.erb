<%# Legenda visual de gráfico (princ. 9). Dois modos:
    items: [{color:, label:}]            -> chave categórica (bolinhas + rótulo)
    scale: {colors:[...], low:, high:}   -> barra de gradiente com rótulo nas pontas (tonalidade) %>
<% if local_assigns[:items].present? %>
  <div class="chart-legend">
    <% items.each do |item| %>
      <span class="legend-item"><span class="legend-swatch" style="background:<%= item[:color] %>;"></span><span class="legend-label"><%= item[:label] %></span></span>
    <% end %>
  </div>
<% elsif local_assigns[:scale].present? %>
  <div class="chart-legend chart-legend--scale">
    <span class="legend-label"><%= scale[:low] %></span>
    <span class="legend-gradient" style="background:linear-gradient(90deg, <%= scale[:colors].join(', ') %>);"></span>
    <span class="legend-label"><%= scale[:high] %></span>
  </div>
<% end %>
