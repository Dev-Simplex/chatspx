<%# Tabela com barra de desempenho + badge de indice. Generaliza o que nps/csat/sla faziam inline.
    locals: columns => {entity:, count:, perf:, index:}, rows => [{name:, count:, ratio:, bar_color:, badge:, badge_class:}] %>
<div class="card" style="padding:0;">
  <table class="perf-table">
    <thead>
      <tr>
        <th><%= columns[:entity] %></th>
        <th class="num"><%= columns[:count] %></th>
        <th><%= columns.fetch(:perf, 'Desempenho') %></th>
        <th class="num"><%= columns[:index] %></th>
      </tr>
    </thead>
    <tbody>
      <% rows.each do |row| %>
        <tr>
          <td><%= row[:name] %></td>
          <td class="num"><%= row[:count] %></td>
          <td><span class="cell-bar"><%= pdf_progress_bar(row[:ratio].to_f, color: row[:bar_color]) %></span></td>
          <td class="num"><span class="badge <%= row[:badge_class] %>"><%= row[:badge] %></span></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
