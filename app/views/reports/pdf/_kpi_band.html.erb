<%# Bloco generico de KPIs. local: cards => [{label:, value:, hint:, modifier:, hero:, small:, status:, meaning:, delta:}]
    status: 'good'|'warn'|'bad' (bolinha de semáforo) · meaning: tradução · delta: html de pdf_delta (princ. 2/3/4). %>
<div class="kpis">
  <% cards.each do |card| %>
    <div class="kpi <%= card[:modifier] %>">
      <div class="label"><%= card[:label] %></div>
      <div class="value <%= 'hero' if card[:hero] %> <%= 'sm' if card[:small] %>"><% if card[:status].present? %><span class="status-dot status-dot--<%= card[:status] %>"></span><% end %><%= card[:value] %></div>
      <% if card[:meaning].present? %><div class="kpi-meaning"><%= card[:meaning] %></div><% end %>
      <% if card[:hint].present? %><div class="hint"><%= card[:hint] %></div><% end %>
      <% if card[:delta].present? %><div class="kpi-delta"><%= card[:delta] %></div><% end %>
    </div>
  <% end %>
</div>
