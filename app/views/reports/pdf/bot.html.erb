<%
  k = @data[:kpis]
  resolution_rate = k[:resolution_rate].to_f
  handoff_rate = k[:handoff_rate].to_f

  resolutions_series = @data.dig(:timeseries, :resolutions)
  handoffs_series = @data.dig(:timeseries, :handoffs)
  inboxes = @data[:inboxes]
%>

<%# ---------- Veredito (cards: resolução e handoff) ---------- %>
<% if @data[:verdict] %>
  <div class="section">
    <div class="verdict-grid">
      <%= render 'reports/pdf/verdict', v: @data[:verdict] %>
      <% if @data[:verdict_secondary] %>
        <%= render 'reports/pdf/verdict', v: @data[:verdict_secondary] %>
      <% end %>
    </div>
  </div>
<% end %>

<%# ---------- KPIs ---------- %>
<div class="section">
  <%= render 'reports/pdf/kpi_band', cards: [
    { label: 'Taxa de resolução', value: "#{resolution_rate.round}%", hero: true, hint: 'resolvidas pelo bot' },
    { label: 'Conversas do bot', value: number_with_delimiter(k[:conversations]) },
    { label: 'Mensagens', value: number_with_delimiter(k[:messages]) },
    { label: 'Taxa de handoff', value: "#{handoff_rate.round}%", modifier: 'is-passive', hint: 'transferidas à equipe' },
    { label: 'Resoluções', value: number_with_delimiter(k[:resolutions]), modifier: 'is-promoter' },
    { label: 'Transferências', value: number_with_delimiter(k[:handoffs]) },
  ] %>
</div>

<%# ---------- Resolucoes por dia ---------- %>
<% if resolutions_series.present? %>
  <div class="section">
    <div class="section-title"><span class="dot">1</span> Resoluções por dia</div>
    <div class="card">
      <%= pdf_bar_chart(resolutions_series, color: '#2dc46f') %>
      <%= render 'reports/pdf/chart_legend', items: [{ color: '#2dc46f', label: 'conversas resolvidas pelo bot no dia' }] %>
    </div>
  </div>
<% end %>

<%# ---------- Transferencias por dia ---------- %>
<% if handoffs_series.present? %>
  <div class="section">
    <div class="section-title"><span class="dot">2</span> Transferências por dia</div>
    <div class="card">
      <%= pdf_bar_chart(handoffs_series, color: '#ffc53d') %>
      <%= render 'reports/pdf/chart_legend', items: [{ color: '#ffc53d', label: 'conversas transferidas para a equipe no dia' }] %>
    </div>
  </div>
<% end %>

<%# ---------- Desempenho por caixa ---------- %>
<div class="section">
  <div class="section-title"><span class="dot">3</span> Desempenho por caixa</div>
  <% if inboxes.present? %>
    <div class="card" style="padding:0;">
      <%= render 'reports/pdf/data_table', table: {
        columns: [
          { label: 'Caixa' },
          { label: 'Conversas', align: 'right' },
          { label: 'Resoluções', align: 'right' },
          { label: 'Transferências', align: 'right' },
          { label: 'Taxa resolução', align: 'right' }
        ],
        rows: inboxes.first(18).map { |row|
          [row[:name], number_with_delimiter(row[:conversations]),
           number_with_delimiter(row[:resolutions]), number_with_delimiter(row[:handoffs]),
           "#{row[:resolution_rate].to_f.round}%"]
        }
      } %>
    </div>
  <% else %>
    <%= render 'reports/pdf/callout', variant: 'neutral',
          title: 'Sem caixas com bot ativo',
          body: 'Nenhuma caixa de entrada teve o bot ativo no período analisado.' %>
  <% end %>
</div>

<%# ---------- Conclusao (data-driven) ---------- %>
<div class="section">
  <%= render 'reports/pdf/conclusion',
        title: 'Leitura executiva',
        body: raw("A automação resolveu <span class=\"hl\">#{resolution_rate.round}%</span> das #{number_with_delimiter(k[:conversations])} conversas atendidas, totalizando <span class=\"hl\">#{number_with_delimiter(k[:resolutions])} resoluções</span> sem intervenção humana e <span class=\"hl\">#{number_with_delimiter(k[:handoffs])} transferências</span> (#{handoff_rate.round}%) encaminhadas à equipe. #{resolution_rate >= 60 ? 'O patamar indica fluxos bem cobertos; mantenha o monitoramento das transferências para preservar o índice.' : 'Revisar os fluxos das transferências mais frequentes tende a elevar a taxa de resolução automática.'}") %>
</div>
