<%# Caixa de destaque / veredito. locals: variant (success|warning|error|info|neutral), title, body %>
<% variant = local_assigns.fetch(:variant, 'neutral') %>
<div class="callout callout--<%= variant %>">
  <span class="callout-icon">
    <% case variant %>
    <% when 'success' %>
      <svg viewBox="0 0 20 20" width="16" height="16"><path d="M7.5 13.5 4 10l1.4-1.4 2.1 2.1L14.6 5l1.4 1.4z" fill="currentColor"/></svg>
    <% when 'warning', 'error' %>
      <svg viewBox="0 0 20 20" width="16" height="16"><path d="M10 3.5 18 17H2zM9 8v4h2V8zm0 5v2h2v-2z" fill="currentColor"/></svg>
    <% else %>
      <svg viewBox="0 0 20 20" width="16" height="16"><path d="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16zm1 12H9V9h2zm0-6H9V6h2z" fill="currentColor"/></svg>
    <% end %>
  </span>
  <div class="callout-text">
    <% if local_assigns[:title].present? %><div class="callout-title"><%= title %></div><% end %>
    <% if local_assigns[:body].present? %><div class="callout-body"><%= body %></div><% end %>
  </div>
</div>
