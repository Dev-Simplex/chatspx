<%# Cards de metodologia com check. locals: cards => [{title:, body:}] %>
<div class="check-cards">
  <% cards.each do |card| %>
    <div class="check-card">
      <span class="check-mark">
        <svg viewBox="0 0 20 20" width="13" height="13"><path d="M7.5 13.5 4 10l1.4-1.4 2.1 2.1L14.6 5l1.4 1.4z" fill="currentColor"/></svg>
      </span>
      <div>
        <div class="check-title"><%= card[:title] %></div>
        <% if card[:body].present? %><div class="check-body"><%= card[:body] %></div><% end %>
      </div>
    </div>
  <% end %>
</div>
