<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Entrando no Chat SPX Tozi...</title>
  <style>
    :root { color-scheme: dark light; }
    body { background: #0f172a; color: #e2e8f0; font-family: -apple-system, system-ui, sans-serif; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; margin: 0; text-align: center; padding: 20px; }
    @media (prefers-color-scheme: light) {
      body { background: #f8fafc; color: #0f172a; }
      .spinner { border-color: #cbd5e1; border-top-color: #2dc46f; }
    }
    h1 { color: #2dc46f; margin: 16px 0 8px; font-size: 1.5rem; }
    p { opacity: 0.85; margin: 4px 0; }
    .spinner { width: 48px; height: 48px; border: 4px solid #1e293b; border-top-color: #2dc46f; border-radius: 50%; animation: spin 0.9s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .link { color: #2dc46f; text-decoration: underline; }
  </style>
</head>
<body>
  <div class="spinner" role="status" aria-label="Entrando..."></div>
  <h1>Logando você no Chat SPX Tozi…</h1>
  <p>Aguarde, redirecionando.</p>
  <noscript>
    <p style="color:#f43f5e;margin-top:1rem">JavaScript está desativado.</p>
    <p><a class="link" href="/app/login">Ir para login manual</a></p>
  </noscript>
  <script>
    (function() {
      try {
        var headers = <%= raw json_escape(@headers.to_json) %>;
        // js-cookie no front faz Cookies.set sem encode adicional; aqui SETAMOS o JSON
        // como string direta (sem encodeURIComponent — o front lê via Cookies.get +
        // JSON.parse e isso aceita JSON puro). encodeURIComponent quebrava o parse.
        var isHttps = window.location.protocol === 'https:';
        var d = new Date(); d.setTime(d.getTime() + (14*24*60*60*1000));
        var cookie = 'cw_d_session_info=' + JSON.stringify(headers) + '; expires=' + d.toUTCString() + '; path=/; SameSite=Lax' + (isHttps ? '; Secure' : '');
        document.cookie = cookie;
        setTimeout(function() {
          window.location = <%= raw json_escape(@redirect_path.to_json) %>;
        }, 250);
      } catch (e) {
        document.body.innerHTML = '<h1>Erro ao logar automaticamente</h1>' +
          '<p>' + (e.message || 'desconhecido') + '</p>' +
          '<p><a class="link" href="/app/login">Ir para login manual</a></p>';
      }
    })();
  </script>
</body>
</html>
