<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title><%= @data[:title] %></title>
  <style><%= render 'reports/pdf/shared_css' %></style>
</head>
<body>
  <section class="page">
    <header class="mast">
      <div class="mast-top">
        <%# Simbolo vetor inline (logo_thumbnail2.svg) recolorido para fundo verde —
            evita o logo_dark.svg que embrulha PNG e renderiza borrado. %>
        <svg class="logo" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
          <path d="M8 16C12.4183 16 16 12.4183 16 8C16 3.58172 12.4183 0 8 0C3.58172 0 0 3.58172 0 8C0 12.4183 3.58172 16 8 16Z" fill="#ffffff"/>
          <path d="M11.4172 11.4172H7.70831C5.66383 11.4172 4 9.75328 4 7.70828C4 5.66394 5.66383 4 7.70835 4C9.75339 4 11.4172 5.66394 11.4172 7.70828V11.4172Z" fill="#2dc46f"/>
        </svg>
        <span class="brand">ChatSPX</span>
        <span class="mast-overline"><%= @data[:overline] || 'Relatório Analítico · Confidencial' %></span>
      </div>
      <div class="mast-title"><%= @data[:title] %></div>
      <div class="mast-sub"><%= @data[:subtitle] || @data.dig(:period, :label) %></div>
    </header>

    <main class="body">
      <%
        meta_items = [
          { label: 'Cliente', value: @account.name },
          { label: 'Período', value: @data.dig(:period, :label) },
          { label: 'Base analisada', value: @data[:base_label] || '—' },
          { label: 'Emissão', value: @generated_at.in_time_zone('America/Manaus').strftime('%d/%m/%Y %H:%M') }
        ]
      %>
      <%= render 'reports/pdf/meta_strip', items: meta_items %>

      <%= yield %>
    </main>
  </section>
</body>
</html>
