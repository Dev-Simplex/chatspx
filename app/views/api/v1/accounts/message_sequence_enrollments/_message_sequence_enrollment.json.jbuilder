json.id message_sequence_enrollment.id
json.status message_sequence_enrollment.status
json.current_step_position message_sequence_enrollment.current_step_position
json.next_run_at message_sequence_enrollment.next_run_at
json.conversation_id message_sequence_enrollment.conversation_id
json.created_at message_sequence_enrollment.created_at

json.message_sequence do
