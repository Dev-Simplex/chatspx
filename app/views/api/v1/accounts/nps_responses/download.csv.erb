<%=
  CSV.generate_line([
    I18n.t('reports.nps.headers.agent_name', default: 'Agent Name'),
    I18n.t('reports.nps.headers.score', default: 'Score'),
    I18n.t('reports.nps.headers.classification', default: 'Classification'),
    I18n.t('reports.nps.headers.comment', default: 'Comment'),
    I18n.t('reports.nps.headers.contact_name', default: 'Contact Name'),
    I18n.t('reports.nps.headers.contact_email_address', default: 'Contact Email'),
    I18n.t('reports.nps.headers.contact_phone_number', default: 'Contact Phone'),
    I18n.t('reports.nps.headers.inbox_name', default: 'Inbox Name'),
    I18n.t('reports.nps.headers.link_to_the_conversation', default: 'Link to Conversation'),
    I18n.t('reports.nps.headers.sent_at', default: 'Sent At'),
    I18n.t('reports.nps.headers.answered_at', default: 'Answered At'),
    I18n.t('reports.nps.headers.status', default: 'Status')
  ])
-%>
<% @nps_responses.each do |nps_response| %>
<% assigned_agent = nps_response.assigned_agent %>
<% contact = nps_response.contact %>
<% conversation = nps_response.conversation %>
<% inbox = nps_response.inbox %>
<%=
  CSV.generate_line([
    assigned_agent ? "#{assigned_agent.name} (#{assigned_agent.email})" : nil,
    nps_response.score,
    nps_response.classification,
    nps_response.comment.present? ? nps_response.comment : nil,
    contact&.name.present? ? contact&.name: nil,
    contact&.email.present? ? contact&.email: nil,
    contact&.phone_number.present? ? contact&.phone_number: nil,
    inbox&.name.present? ? inbox&.name: nil,
    conversation ? app_account_conversation_url(account_id: Current.account.id, id: conversation.display_id): nil,
    nps_response.sent_at,
    nps_response.answered_at,
    nps_response.status
]).html_safe
-%>
<% end %>
<%=
  CSV.generate_line([
    I18n.t(
      'reports.period',
      since: params[:since].present? ? Date.strptime(params[:since], '%s') : nil,
      until: params[:until].present? ? Date.strptime(params[:until], '%s') : nil
    )
  ]) if params[:since].present? && params[:until].present?
-%>
