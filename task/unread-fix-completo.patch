index 000000000..b9f5c50c2
--- /dev/null
+++ b/app/javascript/dashboard/helper/specs/unreadViewHelper.spec.js
@@ -0,0 +1,100 @@
+import {
+  UNREAD_ROUTES,
+  defaultAssigneeTab,
+  resolveAssigneeTab,
+} from '../unreadViewHelper';
+import wootConstants from 'dashboard/constants/globals';
+
+const { ME, UNASSIGNED, ALL } = wootConstants.ASSIGNEE_TYPE;
+
+describe('unreadViewHelper', () => {
+  describe('UNREAD_ROUTES', () => {
+    it('lists both unread route names', () => {
+      expect(UNREAD_ROUTES).toEqual([
+        'conversation_unread',
+        'conversation_through_unread',
+      ]);
+    });
+  });
+
+  describe('#defaultAssigneeTab', () => {
+    it('defaults unread routes to ALL', () => {
+      expect(defaultAssigneeTab('conversation_unread')).toBe(ALL);
+      expect(defaultAssigneeTab('conversation_through_unread')).toBe(ALL);
+    });
+
+    it('defaults unattended route to ME', () => {
+      expect(defaultAssigneeTab('conversation_unattended')).toBe(ME);
+    });
+
+    it('defaults other routes to ME', () => {
+      expect(defaultAssigneeTab('home')).toBe(ME);
+      expect(defaultAssigneeTab(undefined)).toBe(ME);
+    });
+
+    it('respects ?assignee_type=all over the route default', () => {
+      expect(
+        defaultAssigneeTab('conversation_unattended', { assignee_type: 'all' })
+      ).toBe(ALL);
+      expect(defaultAssigneeTab('home', { assignee_type: 'all' })).toBe(ALL);
+    });
+
+    it('respects ?assignee_type=unassigned', () => {
+      expect(
+        defaultAssigneeTab('conversation_unread', {
+          assignee_type: 'unassigned',
+        })
+      ).toBe(UNASSIGNED);
+    });
+
+    it('respects ?assignee_type=me even on unread routes', () => {
+      expect(
+        defaultAssigneeTab('conversation_unread', { assignee_type: 'me' })
+      ).toBe(ME);
+    });
+
+    it('ignores unknown assignee_type and falls back to the route default', () => {
+      expect(
+        defaultAssigneeTab('conversation_unread', { assignee_type: 'bogus' })
+      ).toBe(ALL);
+      expect(
+        defaultAssigneeTab('conversation_unattended', {
+          assignee_type: 'bogus',
+        })
+      ).toBe(ME);
+    });
+  });
+
+  describe('#resolveAssigneeTab', () => {
+    it('returns the route default when no allowedKeys are given', () => {
+      expect(resolveAssigneeTab('conversation_unread')).toBe(ALL);
+      expect(resolveAssigneeTab('conversation_unread', {}, [])).toBe(ALL);
+    });
+
+    it('keeps the default when it is among the allowed tabs', () => {
+      expect(
+        resolveAssigneeTab('conversation_unread', {}, [ME, UNASSIGNED, ALL])
+      ).toBe(ALL);
+    });
+
+    it('clamps to the first allowed tab when the default is not permitted', () => {
+      // Enterprise custom-role agent: only Mine/Unassigned tabs are rendered,
+      // so the unread ALL default must fall back instead of leaving no tab.
+      expect(
+        resolveAssigneeTab('conversation_unread', {}, [ME, UNASSIGNED])
+      ).toBe(ME);
+      expect(resolveAssigneeTab('conversation_unread', {}, [UNASSIGNED])).toBe(
+        UNASSIGNED
+      );
+    });
+
+    it('clamps a deep-link assignee_type the user is not allowed to use', () => {
+      expect(
+        resolveAssigneeTab('conversation_unread', { assignee_type: 'all' }, [
+          ME,
+          UNASSIGNED,
+        ])
+      ).toBe(ME);
+    });
+  });
+});
diff --git a/app/javascript/dashboard/helper/unreadViewHelper.js b/app/javascript/dashboard/helper/unreadViewHelper.js
new file mode 100644
index 000000000..283464f25
--- /dev/null
+++ b/app/javascript/dashboard/helper/unreadViewHelper.js
@@ -0,0 +1,51 @@
+import wootConstants from 'dashboard/constants/globals';
+
+// Route names for the custom "Unread" view. They reuse the standard
+// ConversationView/ChatList, but should default to the "All" assignee tab so
+// admins/agents see every accessible unread conversation. The backend
+// PermissionFilterService still scopes the result set per role.
+export const UNREAD_ROUTES = [
+  'conversation_unread',
+  'conversation_through_unread',
+];
+
+/**
+ * Resolve the initial/active assignee tab for a given route.
+ *
+ * Priority:
+ *   1. Explicit `?assignee_type` query param (deep-link) wins.
+ *   2. Unread routes default to ALL (admin/agent see everything accessible).
+ *   3. Everything else (incl. unattended) defaults to ME.
+ *
+ * @param {string} routeName - Vue route name.
+ * @param {Object} [query] - Route query params.
+ * @returns {string} One of wootConstants.ASSIGNEE_TYPE values.
+ */
+export const defaultAssigneeTab = (routeName, query = {}) => {
+  if (query.assignee_type === 'me') return wootConstants.ASSIGNEE_TYPE.ME;
+  if (query.assignee_type === 'unassigned')
+    return wootConstants.ASSIGNEE_TYPE.UNASSIGNED;
+  if (query.assignee_type === 'all') return wootConstants.ASSIGNEE_TYPE.ALL;
+  if (UNREAD_ROUTES.includes(routeName)) return wootConstants.ASSIGNEE_TYPE.ALL;
+  return wootConstants.ASSIGNEE_TYPE.ME;
+};
+
+/**
+ * Like defaultAssigneeTab, but clamps the result to the set of tabs the user is
+ * actually allowed to see. The "all" tab is permission-gated, so an Enterprise
+ * custom-role agent (e.g. only conversation_unassigned_manage) can reach the
+ * unread route while the ALL tab is filtered out — initializing the tab to ALL
+ * would then leave no tab highlighted. When the resolved default is not among
+ * the rendered tabs, fall back to the first available tab (else ME).
+ *
+ * @param {string} routeName - Vue route name.
+ * @param {Object} [query] - Route query params.
+ * @param {string[]} [allowedKeys] - Keys of the currently rendered assignee tabs.
+ * @returns {string} One of wootConstants.ASSIGNEE_TYPE values.
+ */
+export const resolveAssigneeTab = (routeName, query = {}, allowedKeys = []) => {
+  const desired = defaultAssigneeTab(routeName, query);
+  if (!Array.isArray(allowedKeys) || allowedKeys.length === 0) return desired;
+  if (allowedKeys.includes(desired)) return desired;
+  return allowedKeys[0] ?? wootConstants.ASSIGNEE_TYPE.ME;
+};
