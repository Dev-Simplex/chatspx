diff --git a/app/finders/conversation_finder.rb b/app/finders/conversation_finder.rb
index a626d04e2..ba91f5a9a 100644
--- a/app/finders/conversation_finder.rb
+++ b/app/finders/conversation_finder.rb
@@ -205,11 +205,22 @@ class ConversationFinder # rubocop:disable Metrics/ClassLength
     return unless params[:q]
 
     allowed_message_types = [Message.message_types[:incoming], Message.message_types[:outgoing]]
+    # Isolamento por agente: não descobrir conversas só pelo conteúdo de mensagem de outro
+    # agente em inbox com a flag ON (admin/sem restrição → cláusula vazia).
+    agent_id = AgentMessageIsolation.viewer_restriction_id(@current_user, @current_account)
+    agent_clause = if agent_id
+                     'AND (messages.agent_id IS NULL OR messages.agent_id = :agent_id ' \
+                       'OR NOT EXISTS (SELECT 1 FROM inboxes WHERE inboxes.id = conversations.inbox_id ' \
+                       'AND inboxes.agent_message_isolation = true))'
+                   else
+                     ''
+                   end
     @conversations = @conversations.where(
       'EXISTS (SELECT 1 FROM messages WHERE messages.conversation_id = conversations.id ' \
-      'AND messages.content ILIKE :search AND messages.message_type IN (:types))',
+      "AND messages.content ILIKE :search AND messages.message_type IN (:types) #{agent_clause})",
       search: "%#{ActiveRecord::Base.sanitize_sql_like(params[:q])}%",
-      types: allowed_message_types
+      types: allowed_message_types,
+      agent_id: agent_id
     )
   end
 
diff --git a/app/finders/message_finder.rb b/app/finders/message_finder.rb
index 2e097d582..2e667b0af 100644
--- a/app/finders/message_finder.rb
+++ b/app/finders/message_finder.rb
@@ -20,13 +20,25 @@ class MessageFinder
   private
 
   def conversation_messages
-    @conversation.messages
-                 .where(inbox_id: @conversation.inbox_id)
-                 .includes(
-                   { attachments: [{ file_attachment: [:blob] }] },
-                   :sender,
-                   sender: { avatar_attachment: [:blob] }
-                 )
+    scope = @conversation.messages
+                         .where(inbox_id: @conversation.inbox_id)
+                         .includes(
+                           { attachments: [{ file_attachment: [:blob] }] },
+                           :sender,
+                           sender: { avatar_attachment: [:blob] }
+                         )
+    apply_agent_isolation(scope)
+  end
+
+  # Isolamento POR AGENTE depende de QUEM olha — por isso (diferente do team isolation,
+  # que vive na association conversation.messages) o filtro mora aqui, onde Current.user
+  # e conhecido. Mesmo acoplamento a Current.user ja usado em Message#reopened_by_contact?.
+  # Listagens do widget/public API nao tem Current.user -> o filtro vira no-op (seguro).
+  def apply_agent_isolation(scope)
+    restriction_id = AgentMessageIsolation.restriction_id_for_inbox(
+      @conversation.inbox, Current.user, @conversation.account_id
+    )
+    AgentMessageIsolation.filter_messages(scope, restriction_id)
   end
 
   def messages
