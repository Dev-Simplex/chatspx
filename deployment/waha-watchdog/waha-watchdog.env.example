# waha-watchdog — config de exemplo.
# Copiar para /etc/waha-watchdog/waha-watchdog.env e preencher.
# NUNCA versionar o arquivo real (contem a API key).
#
#   sudo install -d -m 0750 /etc/waha-watchdog
#   sudo install -m 0640 waha-watchdog.env.example /etc/waha-watchdog/waha-watchdog.env
#   sudo $EDITOR /etc/waha-watchdog/waha-watchdog.env
#
# Formato: KEY=value (lido por systemd EnvironmentFile — sem aspas, sem "export").

# --- Conexao WAHA (obrigatorio) ---
WAHA_API_URL=https://waha.simplexsolucoes.com.br
WAHA_API_KEY=COLOQUE_A_API_KEY_AQUI

# Sessoes a monitorar (espaco ou virgula). Vazio = descobre via /api/sessions?all=true.
# Ex: SESSIONS=default tozi catatau
SESSIONS=

# Status considerados saudaveis (separados por espaco/virgula).
HEALTHY_STATUSES=WORKING

# --- Modo de operacao ---
# true  = SO ALERTA (default seguro): loga/alerta, NUNCA reinicia.
# false = habilita auto-restart de SESSAO (POST /api/sessions/{name}/restart).
# Virar para false SOMENTE depois do periodo de observacao em ALERT_ONLY (ver README).
ALERT_ONLY=true

# --- Rate-limit / cooldown (protege contra restart-storm) ---
COOLDOWN_SECONDS=300
MAX_RESTARTS_PER_WINDOW=3
RESTART_WINDOW_SECONDS=3600

# --- Liveness /ping (crash-loop) ---
PING_RETRIES=5
PING_RETRY_DELAY=5

# --- HTTP ---
CURL_TIMEOUT=10

# --- Alertas (opcional): webhook Slack/Discord/n8n que aceita POST JSON ---
# ALERT_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- Monitor de gap de inbound (SO-ALERTA, opcional / experimental) ---
# Mede o tempo desde o ultimo inbound por sessao para tunar deteccao de freeze.
INBOUND_GAP_MONITOR=false
INBOUND_GAP_THRESHOLD=1800

# STATE_DIR e setado pelo systemd (StateDirectory). So mude se rodar via cron.
# STATE_DIR=/var/lib/waha-watchdog
