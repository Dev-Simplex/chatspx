[Unit]
Description=Dispara o WAHA watchdog a cada ~60s
Documentation=file:///opt/waha-watchdog/README.md

[Timer]
# Primeira execucao 30s apos boot, depois a cada 60s contados do FIM da
# execucao anterior (evita sobreposicao se um ciclo demorar por backoff/ping).
OnBootSec=30s
OnUnitInactiveSec=60s
AccuracySec=5s
Persistent=false
Unit=waha-watchdog.service

[Install]
WantedBy=timers.target
